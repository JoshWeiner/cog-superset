{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "outDir": "lib",
    "declarationDir": "lib",
    "composite": false,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "jsx": "preserve"
  },
  "include": [
    "src/**/*",
    "../superset-core/types/**/*",
    "../superset-ui-core/types/**/*"
  ],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.stories.*"
  ]
}
